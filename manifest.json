{
  "manifest_version": 3,
  "name": "AdBlock — Ads, Trackers",
  "version": "1.0.38",
  "description": "Block ads, trackers, and known malicious domains with simple site controls and focus tools.",
  "permissions": ["storage", "declarativeNetRequest", "alarms", "scripting", "contextMenus"],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content/scriptlets.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["config.js", "content/site-rules-loader.js", "content/content.js", "content/site-block.js", "content/element-picker.js", "content/global-scanner.js", "content/rule-editor.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
       "resources": ["rule/site-rules.txt"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    },
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    },
    {
      "resources": ["web_accessible_resources/1x1.gif", "web_accessible_resources/2x2.png", "web_accessible_resources/32x32.png", "web_accessible_resources/3x2.png", "web_accessible_resources/adthrive_abd.js", "web_accessible_resources/amazon_ads.js", "web_accessible_resources/amazon_apstag.js", "web_accessible_resources/ampproject_v0.js", "web_accessible_resources/chartbeat.js", "web_accessible_resources/click2load.html", "web_accessible_resources/doubleclick_instream_ad_status.js", "web_accessible_resources/empty", "web_accessible_resources/fingerprint2.js", "web_accessible_resources/fingerprint3.js", "web_accessible_resources/google-analytics_analytics.js", "web_accessible_resources/google-analytics_cx_api.js", "web_accessible_resources/google-analytics_ga.js", "web_accessible_resources/google-ima.js", "web_accessible_resources/googlesyndication_adsbygoogle.js", "web_accessible_resources/googletagmanager_gtm.js", "web_accessible_resources/googletagservices_gpt.js", "web_accessible_resources/hd-main.js", "web_accessible_resources/nitropay_ads.js", "web_accessible_resources/noeval-silent.js", "web_accessible_resources/noeval.js", "web_accessible_resources/nofab.js", "web_accessible_resources/noop-0.1s.mp3", "web_accessible_resources/noop-1s.mp4", "web_accessible_resources/noop-vast2.xml", "web_accessible_resources/noop-vast3.xml", "web_accessible_resources/noop-vast4.xml", "web_accessible_resources/noop-vmap1.xml", "web_accessible_resources/noop.css", "web_accessible_resources/noop.html", "web_accessible_resources/noop.js", "web_accessible_resources/noop.json", "web_accessible_resources/noop.txt", "web_accessible_resources/outbrain-widget.js", "web_accessible_resources/popads-dummy.js", "web_accessible_resources/popads.js", "web_accessible_resources/prebid-ads.js", "web_accessible_resources/scorecardresearch_beacon.js", "web_accessible_resources/sensors-analytics.js"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  }
}
