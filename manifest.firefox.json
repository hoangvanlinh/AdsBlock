{
  "manifest_version": 3,
  "name": "AdBlock — Ads, Trackers",
  "version": "1.0.41",
  "description": "Block ads, trackers, and known malicious domains with simple site controls and focus tools.",
  "browser_specific_settings": {
    "gecko": {
      "id": "adblock-ads-trackers@gitadblock",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage", "declarativeNetRequest", "alarms", "scripting", "contextMenus"],
    "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["shared/config.js", "shared/browser-compat.js", "shared/scriptlet-alias-map.js", "shared/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content/scriptlets.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
       "<all_urls>"
      ],
      "js": ["shared/config.js", "shared/browser-compat.js", "content/site-rules-loader.js", "content/content.js", "content/fastpath-storage.js", "content/site-block.js", "content/element-picker.js", "content/global-scanner.js", "content/rule-editor.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
       "resources": ["rule/site-rules.txt"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  }
}
